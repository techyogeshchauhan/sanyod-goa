    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "sweetalert2": "^11.26.25",
    "zod": "^3.25.76"
