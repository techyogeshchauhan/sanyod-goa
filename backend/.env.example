NODE_ENV=development
PORT=4000
# Frontend origin: CORS and links in emails
APP_URL=http://localhost:5173
# Number of reverse proxies in front of the API (Nginx = 1)
TRUST_PROXY=0

MONGODB_URI=mongodb://127.0.0.1:27017/sanyod_replica
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/sanyod_replica_test

SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_USER_MAX_AGE_DAYS=7
SESSION_ADMIN_REMEMBER_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Leave SMTP_HOST empty in development: emails are logged instead of sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SANYOD <noreply@sanyod.in>"
ADMIN_NOTIFY_EMAIL=sanyod@sanyod.in

UPI_ID_DEFAULT=6355034424@upi
UPI_ID_HARDCOPY=hardbook.6355034424@upi
HARDCOPY_SURCHARGE_PAISE=20000
COURSE_DISCOUNT_DEFAULT=40
MAX_IMAGE_UPLOAD_MB=5
MAX_PDF_UPLOAD_MB=50

# Uploads: <dir>/public is served at /media, <dir>/private holds PDFs, screenshots and CVs
# STORAGE_DIR=./storage
# Old PHP site folder: npm run seed copies book PDFs from <dir>/Books_pdf into private storage
LEGACY_SITE_DIR=

# Local end-to-end test runs only (ignored when NODE_ENV=production)
DISABLE_RATE_LIMITS=false

LOG_LEVEL=info
